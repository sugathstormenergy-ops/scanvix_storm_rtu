# =============================================================================
# Storm Energy RTU Platform — environment template
# -----------------------------------------------------------------------------
# Copy to .env (deploy.ps1 does this automatically on first run) and adjust.
# .env is git-ignored and MUST NEVER be committed.
#
# Values set to __GENERATE__ are replaced by deploy.ps1 with random secrets the
# first time it runs. Nothing in this file is a real credential.
#
# Docker deployment (192.168.0.50): compose.yml overrides the container-side
# SQL_SERVER / SQL_DRIVER / MQTT_HOST / ports, so the *_HOST_PORT and DOCKER_*
# values below are what you normally tune. 192.168.0.109 is NOT used here.
# =============================================================================

APP_ENV=production
APP_NAME=Storm Energy RTU Platform
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=__GENERATE__

# ── SQL Server ────────────────────────────────────────────────────────────────
# Native (non-Docker) runs use SQL_SERVER/SQL_PORT directly. Docker containers
# use DOCKER_SQL_SERVER/DOCKER_SQL_PORT (default host.docker.internal:1433).
# Linux containers cannot use Windows Integrated Authentication, so the Docker
# deployment requires SQL authentication with a dedicated least-privilege login.
SQL_SERVER=localhost
SQL_PORT=1433
SQL_DATABASE=STORM_ENERGY_RTU
SQL_USERNAME=storm_rtu_app
SQL_PASSWORD=__GENERATE__
SQL_DRIVER=ODBC Driver 18 for SQL Server
SQL_POOL_SIZE=10
SQL_MAX_OVERFLOW=20
DOCKER_SQL_SERVER=host.docker.internal
DOCKER_SQL_PORT=1433
SQL_CONNECT_TIMEOUT=5

# ── MQTT (Docker broker, separate from the host Mosquitto on :1883) ──────────
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TLS_PORT=8883
MQTT_TLS_ENABLED=false
MQTT_USERNAME=storm_mqtt_service
MQTT_PASSWORD=__GENERATE__
MQTT_CLIENT_ID=storm-rtu-consumer
MQTT_QOS=1

# ── TCP ───────────────────────────────────────────────────────────────────────
TCP_HOST=0.0.0.0
TCP_PORT=8100
TCP_TIMEOUT=300

# ── Docker host port mapping (approved for 192.168.0.50) ─────────────────────
# Do NOT use 80, 1883, 8089, 8090, 1433, 3389 — they belong to existing services.
HTTPS_HOST_PORT=443
HTTP_HOST_PORT=8080
MQTT_HOST_PORT=1884
TCP_HOST_PORT=8100
# Second host port for the SAME storm-tcp listener (container port stays 8100): router NAT public 444 -> this host:444.
TCP_PUBLIC_HOST_PORT=444
API_HOST_PORT=8000
# Bind addresses (0.0.0.0 = all interfaces). The API is always bound to 127.0.0.1.
HTTPS_BIND_ADDRESS=0.0.0.0
HTTP_BIND_ADDRESS=0.0.0.0
MQTT_BIND_ADDRESS=0.0.0.0
TCP_BIND_ADDRESS=0.0.0.0

# ── Host identity (used for the bootstrap certificate SAN and test output) ───
STORM_HOST_IP=192.168.0.50

# ── TLS for the reverse proxy ────────────────────────────────────────────────
# TLS_CERT_DIR is bind-mounted READ-ONLY into nginx; files are never copied.
# Use forward slashes for Windows paths (E:/certs). On 192.168.0.50 the real
# Let's Encrypt certificate lives in E:/certs:
#   TLS_CERT_DIR=E:/certs
#   TLS_CERT_FILE=mqtt.stormenergy.in-chain.pem   (leaf + intermediates)
#   TLS_KEY_FILE=mqtt.stormenergy.in-key.pem
#   TLS_SERVER_NAME=mqtt.stormenergy.in
# Default below = repo-local ./certs (git-ignored); deploy.ps1 generates a
# BOOTSTRAP/TEST self-signed pair there only if that folder has no certificate.
TLS_CERT_DIR=./certs
TLS_CERT_FILE=tls.crt
TLS_KEY_FILE=tls.key
TLS_SERVER_NAME=

# ── Image pins ───────────────────────────────────────────────────────────────
STORM_IMAGE_TAG=local
MOSQUITTO_IMAGE_TAG=2.0.22
NGINX_IMAGE_TAG=1.28-alpine
HELPER_IMAGE_TAG=3.20
