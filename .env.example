# Storm Energy RTU Platform — Example environment configuration
# Copy to .env and fill in real values. NEVER commit .env to git.
# In production, Ansible writes this file from Ansible Vault.

APP_ENV=production
APP_NAME=Storm Energy RTU Platform
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=8e4f4a9d8a1b3c2d9f6e7a8b1c2d3e4f9a8b7c6d5e4f3a2b1c9d8e7f6a5b4c3'

# ── SQL Server ────────────────────────────────────────────────────────────────
SQL_SERVER=192.168.0.109
SQL_PORT=1433
SQL_DATABASE=STORM_ENERGY_RTU
SQL_USERNAME=allipuram_ingest
SQL_PASSWORD=
SQL_DRIVER=ODBC Driver 17 for SQL Server
SQL_POOL_SIZE=10
SQL_MAX_OVERFLOW=20

# ── MQTT ──────────────────────────────────────────────────────────────────────
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TLS_PORT=8883
MQTT_TLS_ENABLED=false
MQTT_CA_CERT=/etc/storm-rtu/certs/ca.crt
MQTT_CLIENT_CERT=/etc/storm-rtu/certs/server.crt
MQTT_CLIENT_KEY=/etc/storm-rtu/certs/server.key
MQTT_USERNAME=storm_mqtt_user
MQTT_PASSWORD=CHANGE_ME
MQTT_CLIENT_ID=storm-rtu-consumer
MQTT_QOS=1

# ── TCP ───────────────────────────────────────────────────────────────────────
TCP_HOST=0.0.0.0
TCP_PORT=8100
TCP_TIMEOUT=300
