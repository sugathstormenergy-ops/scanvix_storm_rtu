# =============================================================================
# Storm Energy RTU — reverse proxy (nginxinc/nginx-unprivileged, runs non-root)
#
#   container :8080  (HTTP)   <- host ${HTTP_HOST_PORT:-8080}
#   container :8443  (HTTPS)  <- host ${HTTPS_HOST_PORT:-443}
#
# This file is an nginx *template*: the image entrypoint renders it to
# /etc/nginx/conf.d/default.conf, substituting ONLY variables that match
# NGINX_ENVSUBST_FILTER (^STORM_TLS_). nginx runtime variables ($host, ...) are
# left untouched.
#
# TLS material: the directory TLS_CERT_DIR (e.g. E:/certs) is bind-mounted
# READ-ONLY at /etc/nginx/certs. File names come from .env:
#   TLS_CERT_FILE -> ${STORM_TLS_CERT_FILE}   (full chain: leaf + intermediates)
#   TLS_KEY_FILE  -> ${STORM_TLS_KEY_FILE}    (private key, never copied or committed)
# deploy.ps1 validates SAN/hostname, expiry, chain and key match before use.
# After certificate renewal: docker compose restart reverse-proxy
#
# Routes:  /api/*  /health  /health/*  /docs  /redoc  /openapi.json -> storm-api:8000
#          /nginx-health -> local liveness
#          everything else (/, /gis-map, /assets/...) -> storm-frontend:8080 (web UI;
#          it answers client-side routes with index.html and never serves /api/)
# RTU TCP (8100) and MQTT (1884) are NOT proxied here; they are published directly.
# =============================================================================

server_tokens off;

# Docker embedded DNS: re-resolve upstreams so a recreated container (new IP)
# does not leave nginx pointing at a stale address.
resolver 127.0.0.11 valid=10s ipv6=off;

log_format storm_main '$remote_addr - [$time_iso8601] "$request" $status $body_bytes_sent '
                      '"$http_user_agent" rt=$request_time upstream=$upstream_status';

server {
    listen 8080 default_server;
    listen 8443 ssl default_server;
    http2 on;
    server_name ${STORM_TLS_SERVER_NAME} _;

    access_log /dev/stdout storm_main;
    error_log  /dev/stderr warn;

    ssl_certificate           /etc/nginx/certs/${STORM_TLS_CERT_FILE};
    ssl_certificate_key       /etc/nginx/certs/${STORM_TLS_KEY_FILE};
    ssl_protocols             TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache         shared:StormTLS:10m;
    ssl_session_timeout       1d;
    ssl_session_tickets       off;

    client_max_body_size 1m;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    # HSTS intentionally not enabled yet (internal validation phase; the certificate
    # has no IP SAN so https://<ip> access still shows a name warning). Later consider:
    # add_header Strict-Transport-Security "max-age=31536000" always;

    set $storm_api      http://storm-api:8000;
    set $storm_frontend http://storm-frontend:8080;

    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection        "";
    proxy_connect_timeout 5s;
    proxy_read_timeout    60s;

    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location /api/        { proxy_pass $storm_api; }
    location = /health    { proxy_pass $storm_api; }
    location /health/     { proxy_pass $storm_api; }
    location = /docs      { proxy_pass $storm_api; }
    location = /redoc     { proxy_pass $storm_api; }
    location = /openapi.json { proxy_pass $storm_api; }

    # "/api" without the trailing slash is still an API path: never hand it to the UI.
    location = /api       { proxy_pass $storm_api; }

    # Web UI (static files + SPA fallback; caching headers are set by storm-frontend).
    location / { proxy_pass $storm_frontend; }
}
