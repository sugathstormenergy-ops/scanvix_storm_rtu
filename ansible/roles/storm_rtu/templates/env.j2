# Storm Energy RTU Platform — Environment Configuration
# Generated by Ansible — do not edit manually on the server
# Sensitive values are injected from Ansible Vault

APP_ENV={{ app_env }}
APP_NAME=Storm Energy RTU Platform
APP_VERSION={{ app_version }}
LOG_LEVEL=INFO

# API
API_HOST={{ api_host }}
API_PORT={{ api_port }}
API_SECRET_KEY={{ api_secret_key }}

# SQL Server
SQL_SERVER={{ sql_server }}
SQL_PORT={{ sql_port }}
SQL_DATABASE={{ sql_database }}
SQL_USERNAME={{ sql_username }}
SQL_PASSWORD={{ sql_password }}
SQL_DRIVER={{ sql_driver }}
SQL_POOL_SIZE=10
SQL_MAX_OVERFLOW=20

# MQTT
MQTT_HOST={{ mqtt_host }}
MQTT_PORT={{ mqtt_port }}
MQTT_TLS_PORT={{ mqtt_tls_port }}
MQTT_TLS_ENABLED={{ mqtt_tls_enabled | lower }}
MQTT_CA_CERT={{ app_cert_dir }}/ca.crt
MQTT_CLIENT_CERT={{ app_cert_dir }}/server.crt
MQTT_CLIENT_KEY={{ app_cert_dir }}/server.key
MQTT_USERNAME={{ mqtt_username }}
MQTT_PASSWORD={{ mqtt_password }}
MQTT_CLIENT_ID={{ mqtt_client_id }}
MQTT_QOS=1

# TCP
TCP_HOST={{ tcp_host }}
TCP_PORT={{ tcp_port }}
TCP_TIMEOUT=300
