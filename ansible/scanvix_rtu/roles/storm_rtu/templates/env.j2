# Storm Energy RTU — Application Configuration
# Generated by Ansible. Do not edit manually.
# Managed by: ansible/scanvix_rtu/roles/storm_rtu/templates/env.j2

# ── Database ──────────────────────────────────────────────────────────────────
# Windows Integrated Authentication — no SQL username/password in .env.
# The StormEnergyRTU-API NSSM service runs as DESKTOP-FL70N9E\svc_ansible,
# which has sysadmin access on DESKTOP-FL70N9E\SQLEXPRESS.
# config.py: SQL_USERNAME="" and SQL_PASSWORD="" (defaults) → Trusted_Connection=yes.
SQL_SERVER={{ scanvix_sql_server }}
SQL_DATABASE={{ scanvix_database_name }}
SQL_USERNAME=
SQL_PASSWORD=

# ── MQTT ──────────────────────────────────────────────────────────────────────
MQTT_HOST={{ scanvix_mqtt_host }}
MQTT_PORT={{ scanvix_mqtt_port }}
MQTT_USERNAME={{ scanvix_mqtt_username }}
MQTT_PASSWORD={{ scanvix_mqtt_password }}
MQTT_TLS_ENABLED={{ scanvix_mqtt_tls_enabled | default(false) | bool | lower }}
MQTT_TLS_PORT={{ scanvix_mqtt_tls_port | default(8883) }}
MQTT_CA_CERT={{ scanvix_mqtt_ca_cert | default("") }}
MQTT_CLIENT_CERT={{ scanvix_mqtt_client_cert | default("") }}
MQTT_CLIENT_KEY={{ scanvix_mqtt_client_key | default("") }}

# ── API ───────────────────────────────────────────────────────────────────────
API_PORT={{ scanvix_api_port }}
API_SECRET_KEY={{ scanvix_api_secret_key }}

# ── TCP listener ──────────────────────────────────────────────────────────────
TCP_HOST=0.0.0.0
TCP_PORT={{ scanvix_tcp_port }}

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE={{ scanvix_logs_dir }}\storm_rtu.log
