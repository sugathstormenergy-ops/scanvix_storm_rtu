# Storm Energy RTU — Mosquitto Configuration
# Generated by Ansible. Do not edit manually.
# Template: ansible/scanvix_rtu/roles/mqtt/templates/mosquitto.conf.j2

# Required for per-listener authentication isolation: without this, the
# security directives (allow_anonymous/password_file) below are NOT scoped
# to their own listener and Mosquitto applies them broker-wide instead.
per_listener_settings true

# Bind to loopback only — no external MQTT access at Gate 2
listener {{ scanvix_mqtt_port }} 127.0.0.1
protocol mqtt

# Authentication — allow_anonymous false + password_file enforced together.
# password_file is created by Gate 2 before this config is activated.
# The file itself is NEVER committed to source control.
allow_anonymous false
password_file {{ scanvix_mqtt_passwd_file }}
{% if scanvix_mqtt_acl_enabled | default(false) | bool %}
# Per-device topic ACL (Phase 4 design -- disabled by default). Scoped to
# ONLY this listener (1883) via per_listener_settings true above. Must
# contain an explicit stanza for allipuram_ingest granting it equivalent
# (unrestricted) access before this is ever turned on in production --
# see roles/mqtt/templates/storm_acl.j2 and the Phase 4 report, item L.
acl_file {{ scanvix_mqtt_acl_file }}
{% endif %}

{% if scanvix_mqtt_bench_enabled | default(false) | bool %}
# ── Temporary office bench listener (LAN-only) ──────────────────────────────
# Added for a physical Scanvix RTU bench test. Separate bench credentials
# (bench_<IMEI>), separate password file -- storm_passwd/allipuram_ingest are
# untouched. Set scanvix_mqtt_bench_enabled: false to remove this listener on
# the next deploy without touching anything above.
listener {{ scanvix_mqtt_bench_port }} {{ scanvix_mqtt_bench_host }}
protocol mqtt
allow_anonymous false
password_file {{ scanvix_mqtt_bench_passwd_file }}
{% endif %}

{% if scanvix_mqtt_tls_enabled | default(false) | bool %}
# -- Production MQTT-over-TLS listener (public ACME certificate) -----------
# {{ scanvix_mqtt_tls_hostname }} : TCP {{ scanvix_mqtt_tls_port }}
# Certificate: Let's Encrypt (DNS-01) / ZeroSSL fallback -- see Phase 2
# design report. Server-only TLS: deliberately NO cafile directive -- this
# architecture does not verify client certificates (no mutual TLS). Reuses
# the same production password file as the 1883 listener; per-device
# credentials/ACLs are provisioned into the SAME acl_file as 1883 (see
# roles/mqtt/templates/storm_acl.j2), not a separate one.
# DISABLED by default (scanvix_mqtt_tls_enabled: false) until a real
# certificate exists at the paths below -- enabling this before the
# certificate files exist would prevent Mosquitto from starting.
listener {{ scanvix_mqtt_tls_port }} 0.0.0.0
protocol mqtt
certfile {{ scanvix_mqtt_tls_certfile }}
keyfile {{ scanvix_mqtt_tls_keyfile }}
tls_version {{ scanvix_mqtt_tls_version }}
allow_anonymous false
password_file {{ scanvix_mqtt_passwd_file }}
# Phase 5 finding: unlike the 1883 listener (where acl_file is gated
# behind the separate scanvix_mqtt_acl_enabled switch, since 1883 is
# ALREADY live today), acl_file here is UNCONDITIONAL -- always rendered
# whenever this whole block renders (i.e. whenever scanvix_mqtt_tls_enabled
# is true). Rationale: 8883 does not exist in production yet, and is being
# built specifically as the per-device credential architecture's future
# home. There must be no way to turn on 8883 without ACL enforcement
# also being active, so unlike 1883 there is no independent "TLS on,
# ACL off" state for this listener to fall into by omission.
acl_file {{ scanvix_mqtt_acl_file }}
{% endif %}

# Logging — path outside Program Files (no spaces; SYSTEM + svc_ansible have write access)
log_dest file {{ scanvix_mqtt_passwd_dir }}\mosquitto_storm.log
log_type error
log_type warning
log_type notice
log_type information

# Persistence — same directory (no spaces; SYSTEM full access)
persistence true
persistence_location {{ scanvix_mqtt_passwd_dir }}\

# Connection limits
max_connections 100
# keepalive_interval removed: bridge-only directive in Mosquitto 2.x
